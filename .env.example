# Chave criada em https://aistudio.google.com/apikey
# Use um projeto marcado como Free Tier e nao vincule faturamento.
GEMINI_API_KEY=

# Modelo multimodal estavel e economico (Gemini 3.8 / 4). Se sua conta nao tiver acesso,
# o programa tentara automaticamente os fallbacks abaixo.
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_VISION=gemini-3.8-flash
GEMINI_MODEL_REASONING=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash

# Pasta onde os projetos serao criados. Deixe vazio para usar a pasta "projetos"
# dentro do programa.
DRSAYGON_WORKSPACE=

# Proxies enviados para analise. Valores baixos poupam upload e processamento.
PROXY_HEIGHT=480
PROXY_FPS=12
PROXY_VIDEO_BITRATE=650k
PROXY_AUDIO_BITRATE=64k

# Renderizacao final local.
OUTPUT_PRESET=veryfast
OUTPUT_CRF=20
OUTPUT_AUDIO_BITRATE=192k

# Motor local de voz (Pocket TTS). O portugues usa o modelo 24l.
VOICE_SERVICE_URL=http://127.0.0.1:8766
VOICE_LANGUAGE=portuguese_24l
VOICE_PROFILE_ID=sandro
VOICE_CANDIDATES_DEFAULT=2
# Seu i7-2600K tem 4 nucleos/8 threads; 4 e um ponto de partida conservador.
DRSAYGON_TTS_THREADS=4

# Autopilot Studio v5 - evidencia dirigida e QA editorial.
GEMINI_ANALYSIS_FPS=5
GEMINI_VERIFY_FPS=8
DIRECTED_SEARCH_WINDOW_SECONDS=6
DIRECTED_SEARCH_OVERLAP_SECONDS=2
DIRECTED_SEARCH_SLOW_FACTOR=4
DIRECTED_SEARCH_MIN_CONFIDENCE=0.72
ROUGH_CUT_QA_ENABLED=1
ROUGH_CUT_QA_THRESHOLD=0.72
ROUGH_CUT_QA_CHUNK_SECONDS=75
GEMINI_ROUGH_QA_FPS=4
# Opcional: fallback para Google Search grounding se a pesquisa oficial gratuita nao encontrar fonte.
# Pode depender do plano/quota da Gemini API. Padrao seguro/gratuito: 0.
DRSAYGON_ALLOW_GOOGLE_SEARCH_GROUNDING=0
